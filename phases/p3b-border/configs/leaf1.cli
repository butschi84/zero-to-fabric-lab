set / routing-policy prefix-set leak-shared-to-corp prefix 10.9.1.0/24 mask-length-range 24..32
set / routing-policy policy leak-shared-to-corp statement 10 match prefix-set leak-shared-to-corp
set / routing-policy policy leak-shared-to-corp statement 10 action policy-result accept
set / routing-policy policy leak-shared-to-corp default-action policy-result reject

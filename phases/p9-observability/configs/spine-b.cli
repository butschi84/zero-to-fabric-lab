set / system name host-name spine-b
set / interface system0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.255.1.1/32
set / network-instance default type default
set / network-instance default interface system0.0
set / routing-policy prefix-set loopbacks prefix 10.255.0.0/16 mask-length-range 32..32
set / routing-policy policy underlay statement 10 match prefix-set loopbacks
set / routing-policy policy underlay statement 10 action policy-result accept
set / network-instance default protocols bgp autonomous-system 65010
set / network-instance default protocols bgp router-id 10.255.1.1
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath allow-multiple-as true
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath maximum-paths 8
set / network-instance default protocols bgp group underlay export-policy [ underlay ]
set / network-instance default protocols bgp group underlay import-policy [ underlay ]
set / network-instance default protocols bgp group underlay failure-detection enable-bfd true
set / network-instance default protocols bgp group underlay failure-detection fast-failover true
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "to leaf-b1"
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.254.11.0/31
set / interface ethernet-1/1 subinterface 0 ip-mtu 9000
set / network-instance default interface ethernet-1/1.0
set / network-instance default protocols bgp neighbor 10.254.11.1 peer-group underlay
set / network-instance default protocols bgp neighbor 10.254.11.1 peer-as 65111
set / network-instance default protocols bgp neighbor 10.254.11.1 description "to leaf-b1"
set / bfd subinterface ethernet-1/1.0 admin-state enable
set / bfd subinterface ethernet-1/1.0 desired-minimum-transmit-interval 1000000
set / bfd subinterface ethernet-1/1.0 required-minimum-receive 1000000
set / bfd subinterface ethernet-1/1.0 detection-multiplier 3
set / interface ethernet-1/7 admin-state enable
set / interface ethernet-1/7 description "to gw-b"
set / interface ethernet-1/7 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/7 subinterface 0 ipv4 address 10.254.11.12/31
set / interface ethernet-1/7 subinterface 0 ip-mtu 9000
set / network-instance default interface ethernet-1/7.0
set / network-instance default protocols bgp neighbor 10.254.11.13 peer-group underlay
set / network-instance default protocols bgp neighbor 10.254.11.13 peer-as 65211
set / network-instance default protocols bgp neighbor 10.254.11.13 description "to gw-b"
set / bfd subinterface ethernet-1/7.0 admin-state enable
set / bfd subinterface ethernet-1/7.0 desired-minimum-transmit-interval 1000000
set / bfd subinterface ethernet-1/7.0 required-minimum-receive 1000000
set / bfd subinterface ethernet-1/7.0 detection-multiplier 3
set / interface ethernet-1/8 admin-state enable
set / interface ethernet-1/8 description "to gw-b2"
set / interface ethernet-1/8 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/8 subinterface 0 ipv4 address 10.254.11.14/31
set / interface ethernet-1/8 subinterface 0 ip-mtu 9000
set / network-instance default interface ethernet-1/8.0
set / network-instance default protocols bgp neighbor 10.254.11.15 peer-group underlay
set / network-instance default protocols bgp neighbor 10.254.11.15 peer-as 65212
set / network-instance default protocols bgp neighbor 10.254.11.15 description "to gw-b2"
set / bfd subinterface ethernet-1/8.0 admin-state enable
set / bfd subinterface ethernet-1/8.0 desired-minimum-transmit-interval 1000000
set / bfd subinterface ethernet-1/8.0 required-minimum-receive 1000000
set / bfd subinterface ethernet-1/8.0 detection-multiplier 3
set / network-instance default protocols bgp group overlay peer-as 65510
set / network-instance default protocols bgp group overlay local-as as-number 65510
set / network-instance default protocols bgp group overlay local-as prepend-global-as false
set / network-instance default protocols bgp group overlay afi-safi evpn admin-state enable
set / network-instance default protocols bgp group overlay afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group overlay transport local-address 10.255.1.1
set / network-instance default protocols bgp group overlay route-reflector client true
set / network-instance default protocols bgp group overlay route-reflector cluster-id 10.255.1.1
set / network-instance default protocols bgp neighbor 10.255.1.11 peer-group overlay
set / network-instance default protocols bgp neighbor 10.255.1.21 peer-group overlay
set / network-instance default protocols bgp neighbor 10.255.1.22 peer-group overlay
set / system grpc-server eda-discovery admin-state disable
set / system logging network-instance mgmt
set / system logging remote-server 172.30.30.202 transport udp
set / system logging remote-server 172.30.30.202 remote-port 5514
set / system logging remote-server 172.30.30.202 facility local6 priority match-above informational
set / system sflow admin-state enable
set / system sflow sample-rate 1000
set / system sflow collector 1 collector-address 172.30.30.202
set / system sflow collector 1 network-instance mgmt
set / system sflow collector 1 source-address 172.30.30.12
set / system sflow collector 1 port 6343
set / interface ethernet-1/1 sflow admin-state enable
set / interface ethernet-1/7 sflow admin-state enable
set / interface ethernet-1/8 sflow admin-state enable

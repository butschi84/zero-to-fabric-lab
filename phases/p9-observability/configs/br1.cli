set / system name host-name br1
set / interface system0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.255.2.11/32
set / network-instance default type default
set / network-instance default interface system0.0
set / routing-policy prefix-set loopbacks prefix 10.255.0.0/16 mask-length-range 32..32
set / routing-policy policy underlay statement 10 match prefix-set loopbacks
set / routing-policy policy underlay statement 10 action policy-result accept
set / network-instance default protocols bgp autonomous-system 65120
set / network-instance default protocols bgp router-id 10.255.2.11
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath allow-multiple-as true
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath maximum-paths 8
set / network-instance default protocols bgp group underlay export-policy [ underlay ]
set / network-instance default protocols bgp group underlay import-policy [ underlay ]
set / network-instance default protocols bgp group underlay failure-detection enable-bfd true
set / network-instance default protocols bgp group underlay failure-detection fast-failover true
set / interface ethernet-1/49 admin-state enable
set / interface ethernet-1/49 description "to ipsec-br"
set / interface ethernet-1/49 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/49 subinterface 0 ipv4 address 10.254.21.1/31
set / interface ethernet-1/49 subinterface 0 ip-mtu 9000
set / network-instance default interface ethernet-1/49.0
set / network-instance default protocols bgp neighbor 10.254.21.0 peer-group underlay
set / network-instance default protocols bgp neighbor 10.254.21.0 peer-as 65320
set / network-instance default protocols bgp neighbor 10.254.21.0 description "to ipsec-br"
set / bfd subinterface ethernet-1/49.0 admin-state enable
set / bfd subinterface ethernet-1/49.0 desired-minimum-transmit-interval 1000000
set / bfd subinterface ethernet-1/49.0 required-minimum-receive 1000000
set / bfd subinterface ethernet-1/49.0 detection-multiplier 3
set / network-instance default protocols bgp group hubs local-as as-number 65520
set / network-instance default protocols bgp group hubs local-as prepend-global-as false
set / network-instance default protocols bgp group hubs afi-safi evpn admin-state enable
set / network-instance default protocols bgp group hubs afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group hubs transport local-address 10.255.2.11
set / network-instance default protocols bgp group hubs multihop admin-state enable
set / network-instance default protocols bgp group hubs multihop maximum-hops 6
set / network-instance default protocols bgp group hubs next-hop-self false
set / routing-policy policy accept-all default-action policy-result accept
set / network-instance default protocols bgp group hubs export-policy [ accept-all ]
set / network-instance default protocols bgp group hubs import-policy [ accept-all ]
set / network-instance default protocols bgp neighbor 10.255.0.21 peer-group hubs
set / network-instance default protocols bgp neighbor 10.255.0.21 peer-as 65500
set / network-instance default protocols bgp neighbor 10.255.0.21 description "hubs to gw-a"
set / network-instance default protocols bgp neighbor 10.255.0.22 peer-group hubs
set / network-instance default protocols bgp neighbor 10.255.0.22 peer-as 65500
set / network-instance default protocols bgp neighbor 10.255.0.22 description "hubs to gw-a2"
set / network-instance default protocols bgp neighbor 10.255.1.21 peer-group hubs
set / network-instance default protocols bgp neighbor 10.255.1.21 peer-as 65510
set / network-instance default protocols bgp neighbor 10.255.1.21 description "hubs to gw-b"
set / network-instance default protocols bgp neighbor 10.255.1.22 peer-group hubs
set / network-instance default protocols bgp neighbor 10.255.1.22 peer-as 65510
set / network-instance default protocols bgp neighbor 10.255.1.22 description "hubs to gw-b2"
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "to br-c1"
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/1 subinterface 0 ipv4 address 10.1.10.1/24
set / interface ethernet-1/2 admin-state enable
set / interface ethernet-1/2 description "to br-g1"
set / interface ethernet-1/2 subinterface 0 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/2 subinterface 0 ipv4 address 10.2.10.1/24
set / tunnel-interface vxlan1 vxlan-interface 50001 type routed
set / tunnel-interface vxlan1 vxlan-interface 50001 ingress vni 50001
set / interface lo1 admin-state enable
set / interface lo1 subinterface 1 admin-state enable
set / interface lo1 subinterface 1 ipv4 admin-state enable
set / interface lo1 subinterface 1 ipv4 address 10.1.255.211/32
set / network-instance corp type ip-vrf
set / network-instance corp admin-state enable
set / network-instance corp description "tenant corp, L3VNI 50001"
set / network-instance corp interface lo1.1
set / network-instance corp interface ethernet-1/1.0
set / network-instance corp vxlan-interface vxlan1.50001
set / network-instance corp protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance corp protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.50001
set / network-instance corp protocols bgp-evpn bgp-instance 1 evi 1
set / network-instance corp protocols bgp-evpn bgp-instance 1 ecmp 8
set / network-instance corp protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:50001
set / network-instance corp protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:50001
set / tunnel-interface vxlan1 vxlan-interface 50002 type routed
set / tunnel-interface vxlan1 vxlan-interface 50002 ingress vni 50002
set / interface lo1 admin-state enable
set / interface lo1 subinterface 2 admin-state enable
set / interface lo1 subinterface 2 ipv4 admin-state enable
set / interface lo1 subinterface 2 ipv4 address 10.2.255.211/32
set / network-instance guest type ip-vrf
set / network-instance guest admin-state enable
set / network-instance guest description "tenant guest, L3VNI 50002"
set / network-instance guest interface lo1.2
set / network-instance guest interface ethernet-1/2.0
set / network-instance guest vxlan-interface vxlan1.50002
set / network-instance guest protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance guest protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.50002
set / network-instance guest protocols bgp-evpn bgp-instance 1 evi 2
set / network-instance guest protocols bgp-evpn bgp-instance 1 ecmp 8
set / network-instance guest protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:50002
set / network-instance guest protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:50002
set / system grpc-server eda-discovery admin-state disable
set / system logging network-instance mgmt
set / system logging remote-server 172.30.30.201 transport udp
set / system logging remote-server 172.30.30.201 remote-port 5514
set / system logging remote-server 172.30.30.201 facility local6 priority match-above informational
set / system sflow admin-state enable
set / system sflow sample-rate 1000
set / system sflow collector 1 collector-address 172.30.30.201
set / system sflow collector 1 network-instance mgmt
set / system sflow collector 1 source-address 172.30.30.25
set / system sflow collector 1 port 6343
set / interface ethernet-1/1 sflow admin-state enable
set / interface ethernet-1/2 sflow admin-state enable
set / interface ethernet-1/49 sflow admin-state enable

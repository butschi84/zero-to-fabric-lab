set / system name host-name leaf3
set / interface system0 admin-state enable
set / interface system0 subinterface 0 ipv4 admin-state enable
set / interface system0 subinterface 0 ipv4 address 10.255.0.13/32
set / network-instance default type default
set / network-instance default interface system0.0
set / interface ethernet-1/49 admin-state enable
set / interface ethernet-1/49 description "to spine1 e1-3"
set / interface ethernet-1/49 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/49 subinterface 0 ipv4 address 10.254.1.5/31
set / interface ethernet-1/49 subinterface 0 ip-mtu 9000
set / network-instance default interface ethernet-1/49.0
set / bfd subinterface ethernet-1/49.0 admin-state enable
set / bfd subinterface ethernet-1/49.0 desired-minimum-transmit-interval 1000000
set / bfd subinterface ethernet-1/49.0 required-minimum-receive 1000000
set / bfd subinterface ethernet-1/49.0 detection-multiplier 3
set / interface ethernet-1/50 admin-state enable
set / interface ethernet-1/50 description "to spine2 e1-3"
set / interface ethernet-1/50 subinterface 0 ipv4 admin-state enable
set / interface ethernet-1/50 subinterface 0 ipv4 address 10.254.2.5/31
set / interface ethernet-1/50 subinterface 0 ip-mtu 9000
set / network-instance default interface ethernet-1/50.0
set / bfd subinterface ethernet-1/50.0 admin-state enable
set / bfd subinterface ethernet-1/50.0 desired-minimum-transmit-interval 1000000
set / bfd subinterface ethernet-1/50.0 required-minimum-receive 1000000
set / bfd subinterface ethernet-1/50.0 detection-multiplier 3
set / interface ethernet-1/1 admin-state enable
set / interface ethernet-1/1 description "to cl3"
set / interface ethernet-1/1 subinterface 0 type bridged
set / interface ethernet-1/1 subinterface 0 admin-state enable
set / network-instance mac-vrf-101 interface ethernet-1/1.0
set / tunnel-interface vxlan1 vxlan-interface 101 type bridged
set / tunnel-interface vxlan1 vxlan-interface 101 ingress vni 10101
set / interface irb0 admin-state enable
set / interface irb0 subinterface 101 admin-state enable
set / interface irb0 subinterface 101 ipv4 admin-state enable
set / interface irb0 subinterface 101 ipv4 address 10.1.1.1/24 anycast-gw true
set / interface irb0 subinterface 101 ipv4 address 10.1.1.1/24 primary
set / interface irb0 subinterface 101 anycast-gw virtual-router-id 1
set / interface irb0 subinterface 101 ipv4 arp learn-unsolicited true
set / interface irb0 subinterface 101 ipv4 arp host-route populate dynamic
set / interface irb0 subinterface 101 ipv4 arp evpn advertise dynamic
set / network-instance mac-vrf-101 type mac-vrf
set / network-instance mac-vrf-101 admin-state enable
set / network-instance mac-vrf-101 interface irb0.101
set / network-instance mac-vrf-101 vxlan-interface vxlan1.101
set / network-instance mac-vrf-101 protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance mac-vrf-101 protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.101
set / network-instance mac-vrf-101 protocols bgp-evpn bgp-instance 1 evi 101
set / network-instance mac-vrf-101 protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:10101
set / network-instance mac-vrf-101 protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:10101
set / tunnel-interface vxlan1 vxlan-interface 50001 type routed
set / tunnel-interface vxlan1 vxlan-interface 50001 ingress vni 50001
set / interface lo1 admin-state enable
set / interface lo1 subinterface 1 admin-state enable
set / interface lo1 subinterface 1 ipv4 admin-state enable
set / interface lo1 subinterface 1 ipv4 address 10.1.255.13/32
set / network-instance corp type ip-vrf
set / network-instance corp admin-state enable
set / network-instance corp description "tenant corp, L3VNI 50001"
set / network-instance corp interface lo1.1
set / network-instance corp interface irb0.101
set / network-instance corp vxlan-interface vxlan1.50001
set / network-instance corp protocols bgp-evpn bgp-instance 1 admin-state enable
set / network-instance corp protocols bgp-evpn bgp-instance 1 vxlan-interface vxlan1.50001
set / network-instance corp protocols bgp-evpn bgp-instance 1 evi 1
set / network-instance corp protocols bgp-evpn bgp-instance 1 ecmp 8
set / network-instance corp protocols bgp-vpn bgp-instance 1 route-target export-rt target:65000:50001
set / network-instance corp protocols bgp-vpn bgp-instance 1 route-target import-rt target:65000:50001
set / routing-policy prefix-set loopbacks prefix 10.255.0.0/24 mask-length-range 32..32
set / routing-policy prefix-set client-nets prefix 10.10.0.0/16 mask-length-range 24..24
set / routing-policy policy underlay statement 10 match prefix-set loopbacks
set / routing-policy policy underlay statement 10 action policy-result accept
set / routing-policy policy underlay statement 20 match prefix-set client-nets
set / routing-policy policy underlay statement 20 action policy-result accept
set / routing-policy community-set origin member [ 65103:2 ]
set / routing-policy policy underlay-out statement 10 match prefix-set loopbacks
set / routing-policy policy underlay-out statement 10 action policy-result accept
set / routing-policy policy underlay-out statement 10 action bgp communities add origin
set / routing-policy policy underlay-out statement 20 match prefix-set client-nets
set / routing-policy policy underlay-out statement 20 action policy-result accept
set / routing-policy policy underlay-out statement 20 action bgp communities add origin
set / network-instance default protocols bgp autonomous-system 65103
set / network-instance default protocols bgp router-id 10.255.0.13
set / network-instance default protocols bgp afi-safi ipv4-unicast admin-state enable
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath allow-multiple-as true
set / network-instance default protocols bgp afi-safi ipv4-unicast multipath maximum-paths 8
set / network-instance default protocols bgp group underlay export-policy [ underlay-out ]
set / network-instance default protocols bgp group underlay import-policy [ underlay ]
set / network-instance default protocols bgp group underlay failure-detection enable-bfd true
set / network-instance default protocols bgp group underlay failure-detection fast-failover true
set / network-instance default protocols bgp group underlay peer-as 65000
set / network-instance default protocols bgp neighbor 10.254.1.4 peer-group underlay
set / network-instance default protocols bgp neighbor 10.254.1.4 description "spine1"
set / network-instance default protocols bgp neighbor 10.254.2.4 peer-group underlay
set / network-instance default protocols bgp neighbor 10.254.2.4 description "spine2"
set / network-instance default protocols bgp group overlay peer-as 65500
set / network-instance default protocols bgp group overlay local-as as-number 65500
set / network-instance default protocols bgp group overlay local-as prepend-global-as false
set / network-instance default protocols bgp group overlay afi-safi evpn admin-state enable
set / network-instance default protocols bgp group overlay afi-safi ipv4-unicast admin-state disable
set / network-instance default protocols bgp group overlay transport local-address 10.255.0.13
set / network-instance default protocols bgp neighbor 10.255.0.1 peer-group overlay
set / network-instance default protocols bgp neighbor 10.255.0.2 peer-group overlay

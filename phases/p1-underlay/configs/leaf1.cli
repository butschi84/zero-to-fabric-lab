set / routing-policy policy from-ext3 statement 10 action policy-result accept
set / routing-policy policy from-ext3 statement 10 action bgp local-preference set 200
set / routing-policy policy from-ext3 default-action policy-result reject
set / network-instance default protocols bgp neighbor 10.253.3.1 peer-group testpeers
set / network-instance default protocols bgp neighbor 10.253.3.1 peer-as 64503
set / network-instance default protocols bgp neighbor 10.253.3.1 description "test peer ext3"
